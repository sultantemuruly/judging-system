{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; [ -f .env ] && . ./.env; set +a; cd server && go run ./cmd/server"],
      "port": 8080
    },
    {
      "name": "client",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd client && npm run dev"],
      "port": 5173
    }
  ]
}
