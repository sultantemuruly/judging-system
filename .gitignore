# ============================================================
#  Judging System — .gitignore
#  Backend: Go | Frontend: Vite + React + TypeScript
# ============================================================

# ----------------------------
# Go
# ----------------------------
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out

# Go workspace
go.work
go.work.sum

# Dependency vendor directory (uncomment if not vendoring)
# vendor/

# Build output
/server/judging-server
/server/judging-server.exe

# ----------------------------
# Frontend (Node / Vite)
# ----------------------------
node_modules/
dist/
dist-ssr/
*.local

# Vite cache
.vite/

# ----------------------------
# Data files (runtime state)
# ----------------------------
# Tournament data is generated at runtime — don't commit it
server/tournament_data.json

# ----------------------------
# Environment & secrets
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Logs & debug
# ----------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lint reports
lint_errors.txt

# ----------------------------
# OS & editor artifacts
# ----------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# JetBrains IDEs (GoLand, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# ----------------------------
# Misc
# ----------------------------
*.bak
*.tmp
*.swp
*~
